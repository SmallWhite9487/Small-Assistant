# SHA-256 of the web access key. Create it with: python3 web/app.py --set-key
WEB_ACCESS_KEY_SHA256=

OPENAI_API_KEY=
OPENAI_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.8-flash

# Number of trusted reverse proxies in front of the web app (0 = none).
# Set to 1 behind nginx, Caddy, Cloudflare Tunnel, etc. so logs and the
# sign-in lockout use the visitor's real IP from X-Forwarded-For.
WEB_PROXY_HOPS=0

# Cloudflare Tunnel: the real visitor IP is read from CF-Connecting-IP, but only
# when the connection comes from this machine (cloudflared). Set 0 to disable.
WEB_TRUST_CLOUDFLARE=1
